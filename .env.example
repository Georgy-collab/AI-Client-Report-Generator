# Ключ API ProxyAPI (https://proxyapi.ru)
PROXYAPI_KEY=your_proxyapi_key_here

# Текстовая модель в формате vendor/name (единый API ProxyAPI)
PROXYAPI_MODEL=openai/gpt-4o-mini

# Модель генерации изображений для лого-отчёта
PROXYAPI_IMAGE_MODEL=openai/gpt-image-1-mini
PROXYAPI_IMAGE_SIZE=1024x1024

# Базовый URL единого API ProxyAPI
PROXYAPI_BASE_URL=https://api.proxyapi.ru/v1
